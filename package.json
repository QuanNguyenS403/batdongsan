{
  "name": "batdongsan-monorepo",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @batdongsan/database generate",
    "db:migrate": "pnpm --filter @batdongsan/database migrate:dev",
    "db:seed": "pnpm --filter @batdongsan/database seed",
    "db:studio": "pnpm --filter @batdongsan/database studio",
    "db:import-listings": "pnpm --filter @batdongsan/database import:listings --"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.5.4",
    "prettier": "^3.3.3"
  },
  "packageManager": "pnpm@9.15.9"
}
