# ===== Database =====
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/batdongsan

# ===== Redis =====
REDIS_URL=redis://localhost:6379

# ===== Auth =====
JWT_ACCESS_SECRET=changeme_access
JWT_REFRESH_SECRET=changeme_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===== Admin Bootstrap (Chỉ dùng 1 lần khởi tạo, để trống sau khi tạo xong) =====
ADMIN_BOOTSTRAP_SECRET=
ADMIN_BOOTSTRAP_PHONE=
ADMIN_BOOTSTRAP_PASSWORD=

# ===== SMS OTP (để trống = dùng chế độ MOCK, OTP sẽ in ra console log thay vì gửi SMS thật) =====
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SECRET_KEY=

# ===== Lưu trữ ảnh (để trống = lưu tạm vào ổ đĩa local trong apps/api/uploads) =====
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=batdongsan-images
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# ===== Thanh toán (chưa tích hợp ở bản MVP này) =====
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

# ===== App =====
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
