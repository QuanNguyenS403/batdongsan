# ===== Database =====
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/batdongsan

# ===== Redis =====
REDIS_URL=redis://localhost:6379

# ===== Auth =====
JWT_ACCESS_SECRET=changeme_access
JWT_REFRESH_SECRET=changeme_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===== Admin Bootstrap (Chỉ dùng 1 lần khởi tạo, để trống sau khi tạo xong) =====
ADMIN_BOOTSTRAP_SECRET=
ADMIN_BOOTSTRAP_PHONE=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_FULLNAME=

# ===== Admin RBAC & MFA =====
ADMIN_PHONE=
ADMIN_MFA_ENFORCED=false
ADMIN_MFA_SECRET=
ADMIN_CAPABILITIES_CONFIG=

# ===== CORS =====
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://qnsbroker.com,https://www.qnsbroker.com

# ===== SMS OTP (telegram / mock) =====
# Mặc định = telegram (miễn phí 100% qua Telegram Bot) hoặc mock (in ra console)
SMS_PROVIDER=telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== Lưu trữ ảnh (STORAGE_DRIVER: local hoặc s3) =====
# Mặc định = local (miễn phí 100%, nén WebP bằng Sharp lưu tại apps/api/uploads)
# Tùy chọn Cloudflare R2 miễn phí 10GB/tháng: S3_ENDPOINT, S3_ACCESS_KEY, S3_SECRET_KEY
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=qns-broker-images
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# ===== Thanh toán VietQR & Webhook Ngân hàng 0đ (100% MIỄN PHÍ) =====
BANK_NAME=Vietcombank
BANK_BIN=970436
BANK_ACCOUNT_NUMBER=1050773506
BANK_ACCOUNT_NAME=NGUYEN DUC QUAN
BANK_WEBHOOK_SECRET=

# ===== Google OAuth 1-Click (100% MIỄN PHÍ) =====
# Tạo miễn phí tại https://console.cloud.google.com (OAuth 2.0 Client ID)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ===== App =====
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=https://qnsbroker.com
