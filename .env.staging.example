# =============================================================================
# CẤU HÌNH MÔI TRƯỜNG STAGING (TÁCH BIỆT HOÀN TOÀN KHỎI PRODUCTION & LOCAL)
# =============================================================================

# ===== Định danh môi trường =====
NODE_ENV=production
APP_ENV=staging

# ===== Lớp bảo vệ an toàn (Safety Net) =====
# CƯỠNG CHẾ KHÔNG BAO GIỜ gửi SMS hoặc Email thật tới khách hàng từ môi trường Staging
SAFETY_NET_DISABLE_OUTBOUND=true

# ===== Database Staging riêng biệt =====
DATABASE_URL=postgresql://staging_user:staging_secure_pass@localhost:5432/batdongsan_staging

# ===== Redis Staging riêng biệt (Database 1 thay vì Database 0) =====
REDIS_URL=redis://localhost:6379/1

# ===== Auth (Secret ngẫu nhiên độc lập cho Staging) =====
JWT_ACCESS_SECRET=staging_jwt_access_secret_distinct_from_prod_64_chars_hex_here
JWT_REFRESH_SECRET=staging_jwt_refresh_secret_distinct_from_prod_64_chars_hex_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===== Admin Bootstrap Staging =====
ADMIN_BOOTSTRAP_SECRET=staging_bootstrap_secret_safe_min_16_chars
ADMIN_BOOTSTRAP_PHONE=0900000001
ADMIN_BOOTSTRAP_PASSWORD=StagingAdmin@2026

# ===== SMS OTP (Staging luôn chạy mock hoặc bị Safety Net chặn) =====
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SECRET_KEY=

# ===== Lưu trữ ảnh Staging (Bucket S3 staging riêng hoặc local staging uploads) =====
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=qns-broker-staging-images
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# ===== Email SMTP Staging (Bị Safety Net cưỡng chế chuyển sang Mock log) =====
MAIL_DRIVER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="QNS BROKER Staging <staging-noreply@qnsbroker.com>"

# ===== App =====
API_PORT=4001
NEXT_PUBLIC_API_URL=http://localhost:4001
NEXT_PUBLIC_SITE_URL=http://localhost:3001
